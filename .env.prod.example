# Producción: copiar a .env.prod (nunca se versiona) y completar.
# Generar secretos: python -c "import secrets; print(secrets.token_urlsafe(50))"

# Dominio público (Caddy obtiene el certificado HTTPS) y correo para avisos de
# certificados. Para probar en una laptop: SYNCDANCE_DOMAIN=localhost
SYNCDANCE_DOMAIN=syncdance.example.com
ACME_EMAIL=operaciones@example.com

# Django
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=syncdance.example.com,localhost,backend
DJANGO_CSRF_TRUSTED_ORIGINS=https://syncdance.example.com
# Subir a 31536000 (un año) cuando el dominio sea definitivo.
DJANGO_SECURE_HSTS_SECONDS=86400

# PostgreSQL (también la usa el servicio de copias)
POSTGRES_DB=syncdance
POSTGRES_USER=syncdance
POSTGRES_PASSWORD=

# Procesos: workers de gunicorn y referencias procesadas a la vez
GUNICORN_WORKERS=3
CELERY_CONCURRENCY=1

# Correo (recuperación de contraseña) por SMTP
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=SyncDance <no-responder@syncdance.example.com>

# Copias de seguridad en ./backups
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_HOURS=24

# Navegadores que llaman a la API desde otro origen (normalmente ninguno:
# la web se sirve desde el mismo dominio)
CORS_ALLOWED_ORIGINS=
